{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nscaledev.github.io/chapar/schemas/datacenter/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "datacenter_id", "status", "description", "targets", "provenance"],
  "properties": {
    "schema": {"const": "https://nscaledev.github.io/chapar/schemas/datacenter/v1"},
    "schema_version": {"const": 1},
    "datacenter_id": {"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "status": {"const": "example"},
    "description": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "context_sha256", "tool", "authority_sha256"],
      "properties": {
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"const": "chapar-datacenter"},
            "version": {"pattern": "^1\\.[0-9]+\\.[0-9]+$"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256", "dependencies"],
          "properties": {
            "name": {"const": "chapar_datacenter_template"},
            "version": {"pattern": "^1\\.[0-9]+\\.[0-9]+$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "dependencies": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1},
              "required": ["cookiecutter", "jsonschema", "pydantic", "PyYAML"]
            }
          }
        },
        "authority_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_registry", "datacenter_schema", "target_contract_schema", "target_registry"],
          "properties": {
            "container_registry": {"$ref": "#/$defs/sha256"},
            "datacenter_schema": {"$ref": "#/$defs/sha256"},
            "target_contract_schema": {"$ref": "#/$defs/sha256"},
            "target_registry": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}

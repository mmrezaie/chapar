.DS_Store

# Python import caches
__pycache__/
*.py[cod]

# Spack is installed per user in ~/.local/opt/spack. Do not vendor it here.
/spack/

# Spack runtime/cache artifacts (machine-local)
envs/*/.spack-env/

# Local pi state/config. Project skills under .pi/skills are versioned.
/.pi/settings.json
/.pi/sandbox.json
/.pi/git/
/.pi/npm/

# Container build artifacts
/containers/out/
/containers/**/*.sif
/containers/**/*.simg
/containers/**/packer/packer_cache/
/containers/**/packer/packer.lock.hcl

# Machine-local user-scope Spack overlays generated by local discovery
/etc/user/compilers.yaml
/etc/user/packages.yaml

# Legacy local environment directories; Chapar only tracks envs/hpcsim.
/envs/skipper*/
etc/user/cache/
etc/user/environments/
etc/user/package_repos/
etc/user/package-repository.lock

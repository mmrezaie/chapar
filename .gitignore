.DS_Store

# Python import caches
__pycache__/
*.py[cod]

# Spack is installed per user in ~/.local/opt/spack. Do not vendor it here.
/spack/

# Spack runtime/cache artifacts (machine-local)
envs/*/.spack-env/

# Container build artifacts
/containers/out/
/containers/**/*.sif
/containers/**/*.simg
/containers/**/packer/packer_cache/
/containers/**/packer/packer.lock.hcl

# Machine-local user-scope Spack overlays generated by local discovery
/etc/user/compilers.yaml
/etc/user/packages.yaml

# Machine-local Spack runtime artifacts (cache, repo clone, lock) populated
# via the link-scopes.sh symlink ~/.spack -> etc/user/.
/etc/user/cache/
/etc/user/package-repository.lock
/etc/user/package_repos/

# Site/datacenter-local hpcsim roots, cache roots, groups, and policy.
/envs/hpcsim/hpcsim-site.env

# Site/datacenter-local vlad roots, cache roots, groups, and policy.
/envs/vlad/vlad-site.env

# Site-local validation profile and all hardware-validation result artifacts.
/validation/config/cluster-site.yaml
/validation/results/

# Agent working artifacts (OpenCode planning workspace, link-scopes backups)
.omo/
/etc/*.bak.*/

# Legacy local environment directories; Chapar only tracks envs/hpcsim.
/envs/skipper*/

#!/usr/bin/env bash
# Pre-commit hook: validate Spack changes using incus chapar-rocky10-builder
#
# Runs spack concretization inside the Incus container when Spack-relevant
# files are staged. Aborts the commit if concretization fails.
#
# Skip with: SKIP_INCUS_VALIDATION=1 git commit ...  or  git commit --no-verify

set -euo pipefail

# Allow skipping via env var
if [ "${SKIP_INCUS_VALIDATION:-0}" = "1" ]; then
    exit 0
fi

# Files that affect Spack concretization
RELEVANT_PATTERNS="^(envs/|etc/system/|spack_repo/|ci/)"

# Check if any staged files match relevant patterns
STAGED_FILES=$(git diff --cached --name-only)
if ! echo "$STAGED_FILES" | grep -qE "$RELEVANT_PATTERNS"; then
    exit 0  # Nothing Spack-relevant changed
fi

CONTAINER="${INCUS_CONTAINER:-chapar-rocky10-builder}"
REPO_DIR="/root/workspace/chapar"

# Check if container exists
if ! incus info "$CONTAINER" >/dev/null 2>&1; then
    echo "ERROR: incus container '$CONTAINER' not found." >&2
    echo "  Create it with: incus launch images:rockylinux/10 $CONTAINER" >&2
    echo "  Or override:    INCUS_CONTAINER=<name> git commit ..." >&2
    exit 1
fi

# Ensure container is running
incus start "$CONTAINER" >/dev/null 2>&1 || true

# Push changed files to container
echo "==> Pushing staged Spack files to $CONTAINER..."
while IFS= read -r file; do
    [ -n "$file" ] || continue
    incus file push "$file" "$CONTAINER/$REPO_DIR/$file"
done <<< "$STAGED_FILES"

# Run concretization
echo "==> Running: spack -e envs/hpcsim concretize -f"
if ! incus exec "$CONTAINER" -- bash -lc "cd $REPO_DIR && source ./etc/init.sh && spack -e envs/hpcsim concretize -f"; then
    echo "ERROR: Spack concretization FAILED. Commit aborted." >&2
    echo "  Fix the issue or skip with: SKIP_INCUS_VALIDATION=1 git commit ..." >&2
    exit 1
fi

echo "==> Spack concretization passed."

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nscaledev.github.io/chapar/schemas/vlad-image-containers/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "containers"],
  "properties": {
    "schema": {
      "const": "https://nscaledev.github.io/chapar/schemas/vlad-image-containers/v1"
    },
    "schema_version": {
      "const": 1
    },
    "containers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/container"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
      }
    }
  },
  "$defs": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_image", "source_lock_category", "accepted_software_sets", "allowed_targets", "module_destination", "injection_requirements", "runtime_requirements"],
      "properties": {
        "base_image": {
          "pattern": "^[a-z0-9][a-z0-9./-]{0,255}$"
        },
        "source_lock_category": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "accepted_software_sets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["vlad", "hpcsim", "all"]
          }
        },
        "allowed_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          }
        },
        "module_destination": {
          "pattern": "^/[A-Za-z0-9._/-]+$"
        },
        "injection_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["closure_deptypes", "preserve_base_environment", "prefix_policy"],
          "properties": {
            "closure_deptypes": {
              "const": ["link", "run"]
            },
            "preserve_base_environment": {
              "const": true
            },
            "prefix_policy": {
              "const": "build-time-absolute"
            }
          }
        },
        "runtime_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activation", "require_module_command", "required_roles"],
          "properties": {
            "activation": {
              "const": "module-use-opt-in"
            },
            "require_module_command": {
              "const": true
            },
            "required_roles": {
              "const": ["builders", "validators", "publishers"]
            }
          }
        }
      }
    }
  }
}

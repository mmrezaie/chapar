#!/usr/bin/env bash
set -eo pipefail

export CHAPAR_HPCSIM_ROOT="${CHAPAR_HPCSIM_ROOT:-/resources/share/hpcsim}"
export CHAPAR_HPCSIM_OS="${CHAPAR_HPCSIM_OS:-rocky9}"

if [ -r /etc/profile ]; then
    # Load environment-modules and Chapar's profile.d hook when available.
    # shellcheck disable=SC1091
    . /etc/profile
fi

if [ ! -e "${CHAPAR_HPCSIM_ROOT}/${CHAPAR_HPCSIM_OS}/current" ] && [ "${CHAPAR_HPCSIM_QUIET:-false}" != "true" ]; then
    printf 'WARNING: missing hpcsim release: %s\n' "${CHAPAR_HPCSIM_ROOT}/${CHAPAR_HPCSIM_OS}/current" >&2
    printf '         bind /resources or set CHAPAR_HPCSIM_ROOT before running hpcsim modules.\n' >&2
fi

if [ "$#" -eq 0 ]; then
    exec bash --login
fi

exec "$@"

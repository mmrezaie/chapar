{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    },
    "todowrite": "allow",
    "external_directory": "allow",
    "edit": {
      "*": "allow",
      "spack/**": "deny",
      ".spack-env/**": "deny",
      "**/.spack-env/**": "deny",
      ".git/**": "deny",
      "*.lock": "deny",
      "**/*.lock": "deny"
    },
    "bash": {
      "*": "deny",
      "./validation/run list*": "allow",
      "bash -n *": "allow",
      "bash ci/push-buildcache.sh*": "allow",
      "bash ci/sbatch-env-build.sh*": "allow",
      "bash ci/submit-env-build.sh*": "allow",
      "bash containers/images/preflight.sh*": "allow",
      "bash envs/software/release.sh plan*": "allow",
      "bash etc/link-scopes.sh*": "allow",
      "ci/push-buildcache.sh*": "allow",
      "ci/submit-env-build.sh*": "allow",
      "code --diff *": "allow",
      "code -d *": "allow",
      "envs/software/release.sh plan*": "allow",
      "etc/link-scopes.sh*": "allow",
      "gh auth status*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh pr checks*": "allow",
      "gh pr create*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "gh run download*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh workflow list*": "allow",
      "gh workflow run*": "allow",
      "gh workflow view*": "allow",
      "git *": "allow",
      "node .agents/skills/brave-search/content.js*": "allow",
      "node .agents/skills/brave-search/search.js*": "allow",
      "nohup python .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "nohup python3 .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "npm install*": "allow",
      "open /tmp/eval_review_*": "allow",
      "python -m scripts.*": "allow",
      "python .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "python .agents/skills/skill-creator/scripts/quick_validate.py*": "allow",
      "python3 -m json.tool ci/cve-checker-config.json*": "allow",
      "python3 -m py_compile ci/cve-checker.py*": "allow",
      "python3 -m scripts.*": "allow",
      "python3 .agents/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "python3 .agents/skills/skill-creator/scripts/quick_validate.py*": "allow",
      "python3 ci/selection-plan.py*": "allow",
      "python3 tools/chapar_resolve.py*": "allow",
      "source ./etc/init.sh*": "allow",
      "spack --version*": "allow",
      "spack -e envs/* concretize*": "allow",
      "spack -e envs/* config *": "allow",
      "spack -e envs/* find*": "allow",
      "spack -e envs/* module *": "allow",
      "spack -e envs/* spec *": "allow",
      "spack arch*": "allow",
      "spack buildcache *": "allow",
      "spack config *": "allow",
      "spack find*": "allow",
      "spack mirror *": "allow",
      "spack spec *": "allow",
      "uv run tools/chapar_resolve.py*": "allow"
    },
    "task": {
      "explore": "allow",
      "general": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}

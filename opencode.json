{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".pi/skills"]
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": {
      "*": "allow"
    },
    "todowrite": "allow",
    "external_directory": "allow",
    "edit": {
      "*": "allow",
      "spack/**": "deny",
      ".spack-env/**": "deny",
      "**/.spack-env/**": "deny",
      ".pi/settings.json": "deny",
      ".pi/sandbox.json": "deny",
      ".pi/git/**": "deny",
      ".pi/npm/**": "deny",
      ".git/**": "deny",
      "*.lock": "deny"
    },
    "bash": {
      "*": "deny",
      "bash ci/bootstrap-rocky.sh*": "allow",
      "bash ci/container-build.sh*": "allow",
      "bash ci/prepare-hpcsim-root.sh*": "allow",
      "bash ci/push-buildcache.sh*": "allow",
      "bash envs/hpcsim/release.sh*": "allow",
      "bash etc/link-scopes.sh*": "allow",
      "git *": "allow",
      "gh auth status*": "allow",
      "gh auth token*": "allow",
      "gh repo view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh run download*": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh workflow run*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr create*": "allow",
      "gh pr checks*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh api*": "allow",
      "bash -n *": "allow",
      "ci/push-buildcache.sh*": "allow",
      "code -d *": "allow",
      "code --diff *": "allow",
      "envs/hpcsim/release.sh*": "allow",
      "etc/link-scopes.sh*": "allow",
      "kill *": "allow",
      "node .pi/skills/brave-search/content.js*": "allow",
      "node .pi/skills/brave-search/search.js*": "allow",
      "npm install*": "allow",
      "nohup python .pi/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "nohup python3 .pi/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "open /tmp/eval_review_*": "allow",
      "python -m scripts.*": "allow",
      "python .pi/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "python3 -m scripts.*": "allow",
      "python3 .pi/skills/skill-creator/eval-viewer/generate_review.py*": "allow",
      "source ./etc/init.sh*": "allow",
      "spack --version*": "allow",
      "spack arch*": "allow",
      "spack buildcache *": "allow",
      "spack config *": "allow",
      "spack find*": "allow",
      "spack mirror *": "allow",
      "spack spec *": "allow",
      "spack -e envs/* config *": "allow",
      "spack -e envs/* concretize*": "allow",
      "spack -e envs/* find*": "allow",
      "spack -e envs/* install*": "allow",
      "spack -e envs/* module *": "allow",
      "spack -e envs/* spec *": "allow",
      "*/.pi/skills/brave-search/content.js*": "allow",
      "*/.pi/skills/brave-search/search.js*": "allow",
      "*bash envs/hpcsim/release.sh*": "allow",
      "*envs/hpcsim/release.sh*": "allow"
    },
    "task": {
      "*": "allow",
      "explore": "allow",
      "scout": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}

# Copy this file to envs/hpcsim/hpcsim-site.env and edit it for the
# datacenter, cluster, or workstation where hpcsim builds run. The real
# hpcsim-site.env file is ignored by Git.

# home: install under the current user's home resources tree.
# public: install under HPCSIM_PUBLIC_ROOT and prepare shared directories.
: "${CHAPAR_INSTALL_MODE:=home}"

# Default private local roots. Build scratch still uses /tmp or site scratch via
# Spack build_stage and CI/Slurm fast-cache variables.
: "${CHAPAR_HOME_ROOT:=${HOME}/.spack/chapar}"
: "${HPCSIM_HOME_ROOT:=${CHAPAR_HOME_ROOT}/envs/hpcsim}"

# Shared release root for public releases. Set CHAPAR_INSTALL_MODE=public when
# enabling this path, for example /share/base on a cluster or
# /resources/chapar/hpcsim on Incus builders.
: "${HPCSIM_PUBLIC_ROOT:=}"

# Parent root for all shared hpcsim cache state. By default this produces:
#   ${CHAPAR_SHARED_CACHE_ROOT}/buildcache/<os>
#   ${CHAPAR_SHARED_CACHE_ROOT}/ccache/<os>
: "${CHAPAR_SHARED_CACHE_ROOT:=${CHAPAR_HOME_ROOT}/cache}"
: "${CHAPAR_BUILDCACHE_ROOT:=${CHAPAR_SHARED_CACHE_ROOT}/buildcache}"
: "${CHAPAR_CCACHE_ROOT:=${CHAPAR_SHARED_CACHE_ROOT}/ccache}"

# Optional shared package and module roots for public deployments. Leave these
# empty for the default per-OS install tree under ${HPCSIM_ROOT}/<os>/store and
# release-local modulefiles under ${HPCSIM_ROOT}/<os>/releases/<release-id>.
: "${CHAPAR_INSTALL_TREE_ROOT:=}"
: "${CHAPAR_INSTALL_TREE_PROJECTION:=}"
: "${CHAPAR_MODULE_ROOT:=}"

# Example public layout with shared cross-environment install tree and buildcache.
# When CHAPAR_INSTALL_TREE_ROOT is set, the install tree projection includes
# {architecture}, giving a per-OS+microarch store such as:
#   /resources/chapar/install/linux-rocky10-broadwell/gcc-15.3.0/gcc-15.3.0-abc...
# This single tree is shared by ALL environments (vlad, hpcsim, future),
# eliminating duplicate builds of identical packages.
#
# CHAPAR_INSTALL_MODE=public
# HPCSIM_PUBLIC_ROOT=/share/base
# CHAPAR_INSTALL_TREE_ROOT=/resources/chapar/install
# CHAPAR_INSTALL_TREE_PROJECTION='{architecture}/{compiler.name}-{compiler.version}/{name}-{version}-{hash}'
# CHAPAR_BUILDCACHE_ROOT=/resources/chapar/buildcache
# CHAPAR_MODULE_ROOT=/share/base/modulefiles

# Optional shared group and directory mode for public/shared roots.
: "${CHAPAR_SHARED_GROUP:=}"
: "${CHAPAR_SHARED_DIR_MODE:=2775}"

# ccache policy used by release and CI helpers.
: "${CHAPAR_CCACHE_COMPILERCHECK:=content}"
: "${CHAPAR_CCACHE_MAXSIZE:=}"

# Release publishing defaults for manual use. CI overrides these explicitly.
: "${PUBLISH_BUILDCACHE:=false}"
: "${PUBLISH_CURRENT:=false}"
: "${PUBLISH_MODULES:=false}"

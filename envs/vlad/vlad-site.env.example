# Copy this file to envs/vlad/vlad-site.env and edit it for the
# datacenter, cluster, or workstation where vlad builds run. The real
# vlad-site.env file is ignored by Git.

# : "${VAR:=default}" — if VAR is unset/null, set it to default.
# Exporting VAR=value before sourcing this file overrides the default.

# Install mode. Two choices:
# home: install under the current user's home resources tree.
# public: install under VLAD_PUBLIC_ROOT and prepare shared directories.
: "${CHAPAR_INSTALL_MODE:=home}"

# Default private local roots. Build scratch still uses /tmp or site scratch via
# Spack build_stage and CI/Slurm fast-cache variables.
: "${CHAPAR_HOME_ROOT:=${HOME}/.spack/chapar}"
: "${VLAD_HOME_ROOT:=${CHAPAR_HOME_ROOT}/envs/vlad}"

# Shared release root for public releases. Set CHAPAR_INSTALL_MODE=public when
# enabling this path, for example /share/base on a cluster or
# /resources/chapar/vlad on Incus builders.
: "${VLAD_PUBLIC_ROOT:=}"

# Parent root for all shared vlad cache state. By default this produces:
#   ${CHAPAR_SHARED_CACHE_ROOT}/buildcache/<os>
#   ${CHAPAR_SHARED_CACHE_ROOT}/ccache/<os>
: "${CHAPAR_SHARED_CACHE_ROOT:=${CHAPAR_HOME_ROOT}/cache}"
: "${CHAPAR_BUILDCACHE_ROOT:=${CHAPAR_SHARED_CACHE_ROOT}/buildcache}"
: "${CHAPAR_CCACHE_ROOT:=${CHAPAR_SHARED_CACHE_ROOT}/ccache}"

# Optional shared package and module roots for public deployments. Leave these
# empty for the default per-OS install tree under ${VLAD_ROOT}/<os>/store and
# release-local modulefiles under ${VLAD_ROOT}/<os>/releases/<release-id>.
: "${CHAPAR_INSTALL_TREE_ROOT:=}"
: "${CHAPAR_INSTALL_TREE_PROJECTION:=}"
: "${CHAPAR_MODULE_ROOT:=}"

# Example public layout. Replace these with site-local paths. Leaving
# CHAPAR_INSTALL_TREE_ROOT empty keeps package prefixes in
# ${VLAD_PUBLIC_ROOT}/<os>/store while CHAPAR_MODULE_ROOT publishes stable
# ${CHAPAR_MODULE_ROOT}/<arch> symlinks such as
# /share/base/modulefiles/linux-rocky9-x86_64_v4.
# CHAPAR_INSTALL_MODE=public
# VLAD_PUBLIC_ROOT=/share/base
# CHAPAR_INSTALL_TREE_ROOT=
# CHAPAR_INSTALL_TREE_PROJECTION=
# CHAPAR_MODULE_ROOT=/share/base/modulefiles

# Derive the active environment root from the install mode.
: "${VLAD_ROOT:=${VLAD_PUBLIC_ROOT:-${VLAD_HOME_ROOT}}}"

# Chapar-managed root for this environment.
: "${CHAPAR_VLAD_ROOT:=${VLAD_ROOT}}"

# Optional shared group and directory mode for public/shared roots.
: "${CHAPAR_SHARED_GROUP:=}"
: "${CHAPAR_SHARED_DIR_MODE:=2775}"

# ccache policy used by release and CI helpers.
: "${CHAPAR_CCACHE_COMPILERCHECK:=content}"
: "${CHAPAR_CCACHE_MAXSIZE:=}"

# Release publishing defaults for manual use. CI overrides these explicitly.
: "${PUBLISH_BUILDCACHE:=false}"
: "${PUBLISH_CURRENT:=false}"
: "${PUBLISH_MODULES:=false}"

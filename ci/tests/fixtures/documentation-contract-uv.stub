#!/bin/bash
set -euo pipefail
case "${2:-}" in
    tools/chapar_datacenter_template.py)
        if [ "${3:-}" = "render" ]; then
            : > '@MARKERS@/render'
            if [ "${DOC_TEST_MODE:-}" = "fail" ]; then
                exit 37
            fi
            output_root="${6:-}"
            mkdir -p "$output_root/datacenters/example-lab/targets/linux-x86_64-generic"
            : > "$output_root/datacenters/example-lab/datacenter.json"
            : > "$output_root/datacenters/example-lab/targets/linux-x86_64-generic/contract.json"
        else
            : > '@MARKERS@/validate'
        fi
        ;;
    tools/chapar_resolve.py)
        printf '%s\n' "$@" > '@MARKERS@/resolve'
        while [ "$#" -gt 0 ]; do
            if [ "$1" = "--output-dir" ]; then
                output_root="$2"
                break
            fi
            shift
        done
        mkdir -p "$output_root"
        : > "$output_root/selection.json"
        : > "$output_root/spack.yaml"
        : > "$output_root/target-policy.yaml"
        printf '%064d\n' 0
        ;;
    *)
        exit 44
        ;;
esac

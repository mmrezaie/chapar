#!/bin/bash
set -euo pipefail
if [ "${1:-}" = "-c" ]; then
    printf '%s\n' '@TEMP_ROOT@'
    exit 0
fi
case "${1:-}" in
    ci/selection-plan.py)
        printf '%s\n' "$@" > '@MARKERS@/ci'
        ;;
    ci/cve-checker.py)
        printf '%s\n' "$@" > '@MARKERS@/cve'
        ;;
    *)
        exit 43
        ;;
esac
